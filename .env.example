# Valores públicos do projeto de homologação. Não usar o projeto legado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave somente de servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_GOOGLE_ADS_BRIDGE_URL=
ALASTRE_BRIDGE_SECRET=

# OAuth Google server-side. Nunca prefixar com NEXT_PUBLIC_.
# Alterar para ready_for_oauth somente após aprovação do Google e configuração administrativa.
GOOGLE_PROVIDER_AVAILABILITY=pending_provider_approval
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/connections/google/callback

# Mantém qualquer efeito externo bloqueado durante a fundação.
ALASTRE_WRITE_MODE=disabled

# Segredos exclusivos da Edge Function. Sem estas configurações o agente usa fallback por regras.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INPUT_COST_PER_1M_BRL=
OPENAI_OUTPUT_COST_PER_1M_BRL=
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_COST_PER_1M_BRL=
GEMINI_OUTPUT_COST_PER_1M_BRL=
GOOGLE_DRIVE_CLIENTS_ROOT_FOLDER_ID=your-clients-root-folder-id
GOOGLE_DRIVE_CLIENT_TEMPLATE_FOLDER_ID=your-client-template-folder-id

# Segredo exclusivo do worker local para homologação de prospecção
PROSPECTING_WORKER_SECRET_TOKEN=
