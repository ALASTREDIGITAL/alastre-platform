# Valores públicos do projeto de homologação. Não usar o projeto legado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave somente de servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_GOOGLE_ADS_BRIDGE_URL=
ALASTRE_BRIDGE_SECRET=

# Mantém qualquer efeito externo bloqueado durante a fundação.
ALASTRE_WRITE_MODE=disabled

# Segredos exclusivos da Edge Function. Sem estas configurações o agente usa fallback por regras.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INPUT_COST_PER_1M_BRL=
OPENAI_OUTPUT_COST_PER_1M_BRL=
